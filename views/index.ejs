<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Welcome to the File Uploader</h1>
    <% if (user) { %>
        <p>Hello, <%= user.username %>! You are logged in.</p>
        <form action="/logout" method="POST">
            <button type="submit">Logout</button>
        </form>

        <h2>Your Folders</h2>
        <ul>
            <% user.folder.forEach(function(folder) { %>
                <li>
                    <a href="/folders/<%= folder.id %>"><%= folder.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <% if (showRegister) { %>
            <%- include('forms/register') %>
        <% } else { %>
            <%- include('forms/auth') %>
        <% } %>
    <% } %>
</body>
</html>