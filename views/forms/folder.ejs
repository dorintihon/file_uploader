<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= folder.name %></h1>
    TODO: Add edit folder name functionality
    <form action="/folders/<%=folder.id %>/delete" method="POST">
        <button type="submit">Delete Folder</button>
    </form>
    <a href="/folders/<%= folder.id %>/files/addfile">New File</a>
    <ul>
        <% files.forEach(function(file) { %>
            <li>
                <a href="/uploads/<%= file.filename %>"><%= file.originalname %></a>
            </li>
        <% }); %>
    </ul>
</body>
</html>