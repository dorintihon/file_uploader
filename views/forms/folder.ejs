<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <a href="/">Back to Home</a>
    <div id="folder-title">
        <h1 id="folder-name"><%= folder.name %></h1>
        <button type="button" id="edit-btn" class="btn">Edit</button>
    </div>
    <form
        id="edit-form"
        action="/folders/<%= folder.id %>/edit"
        method="POST"
        style="display: none;"
    >
        <input
            type="text"
            name="name"
            value="<%= folder.name %>"
            required
        >

        <button type="submit" class="btn">Save</button>
        <button type="button" id="cancel-btn" class="btn">Cancel</button>
    </form>
    <form action="/folders/<%=folder.id %>/delete" method="POST">
        <button type="submit" class="btn">Delete Folder</button>
    </form>
    <a href="/folders/<%= folder.id %>/files/addfile" class="btn">New File</a>
    <ul>
        <% files.forEach(function(file) { %>
            <li>
                <a href="/folders/<%= folder.id %>/files/<%= file.id %>"><%= file.name %></a>
            </li>
        <% }); %>
    </ul>

    <script>
        const folderTitle = document.getElementById("folder-title");
        const editForm = document.getElementById("edit-form");
        const editBtn = document.getElementById("edit-btn");
        const cancelBtn = document.getElementById("cancel-btn");
        const folderName = document.getElementById("folder-name");

        editBtn.addEventListener("click", () => {
            folderTitle.style.display = "none";
            editForm.style.display = "block";

            editForm.querySelector("input").focus();
        });

        editForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            const response = await fetch(editForm.action, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        name: editForm.querySelector("input").value
                    })
                });

                const result = await response.json();

                if (result.success) {
                    folderName.textContent = result.name;

                    editForm.style.display = "none";
                    folderTitle.style.display = "block";
                }
        });

        cancelBtn.addEventListener("click", () => {
            editForm.style.display = "none";
            folderTitle.style.display = "block";
        });
    </script>
</body>
</html>