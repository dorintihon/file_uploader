<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= folder.name %></h1>
    <li>
        <% folder.files.forEach(function(file) { %>
            <a href="/uploads/<%= file.filename %>"><%= file.originalname %></a><br>
        <% }); %>
    </li>
</body>
</html>