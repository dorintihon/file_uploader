<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <a href="/folders/<%= folderId %>">Back to Folder</a>
    <a href="/">Back to Home</a>
    <h1><%= file.name %></h1>
    <p>Size: <%= file.size %> bytes</p>
    <p>Uploaded: <%= file.createdAt %></p>


    
    <form action="/folders/<%= folderId %>/files/<%= file.id %>/download" method="GET" target="_blank">
        <button type="submit" class="btn">View</button>
    </form>


    <form action="/folders/<%= folderId %>/files/<%= file.id %>/delete" method="POST">
        <button type="submit" class="btn">Delete File</button>
    </form>
</body>
</html>